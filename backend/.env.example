# ==============================================================================
# NiyamGraph Backend Environment Configuration (Template / Example)
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Database URLs (Psycopg 3 sync dialect: postgresql+psycopg://...)
# Production/Target Neon PostgreSQL pooled connection (with sslmode=require)
DATABASE_URL=postgresql+psycopg://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require

# Dedicated Development Neon branch or local PostgreSQL
DEV_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/niyamgraph_dev

# Dedicated Isolated Test Database (Must NOT equal DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/niyamgraph_test

# Application Environment (development, staging, production)
ENVIRONMENT=development

# JWT Authentication
# In production, must be a cryptographically secure random string >= 32 characters
JWT_SECRET_KEY=replace_with_a_secure_random_key_of_at_least_32_characters_for_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login Security & Account Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS Allowed Origins (Comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# API Documentation (/docs, /redoc, /openapi.json)
DOCS_ENABLED=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Storage Configuration
# Options: local, s3, supabase
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=pdf,png,jpg,jpeg

# Development Seed Password (Required only when running backend/seed.py)
DEV_SEED_PASSWORD=


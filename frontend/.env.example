# Central API Gateway (FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Route Protection Toggle (Default: false for open development access)
VITE_AUTH_GUARD_ENABLED=false

# Supabase Auth Configuration (Client-side public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Platform Info
VITE_APP_VERSION=1.0.0

# Demonstration Access Credentials (Institution Login)
# NOTE: All VITE_ variables are embedded in the compiled client-side JavaScript bundle and are publicly visible.
# Never configure production passwords, secret keys, or real database credentials here.
VITE_SHOW_DEMO_CREDENTIALS=true
VITE_DEMO_INSTITUTION_ID=TEST-PID-1-93821094
VITE_DEMO_EMAIL=test.admin@apex.edu.in
VITE_DEMO_PASSWORD=YourTestPassword123!

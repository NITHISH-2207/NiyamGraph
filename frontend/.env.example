# Central API Gateway (FastAPI)
# Local development: defaults to http://localhost:8000/api/v1
# Vercel Production deployment: set to your deployed backend URL or leave empty for same-origin (/api/v1)
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Route Protection Toggle (Default: false for open development access)
VITE_AUTH_GUARD_ENABLED=false

# Supabase Auth Configuration (Client-side public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Platform Info
VITE_APP_VERSION=1.0.0
